  "components": {
    "schemas": {
      "AdminRegisterRequest": {
        "required": [
          "email",
          "fullName",
          "mobileNumber",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "mobileNumber": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 6,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChangeUserRoleRequest": {
        "required": [
          "email",
          "newRole"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "newRole": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Dependency": {
        "type": "object",
        "properties": {
          "dependencyID": {
            "type": "integer",
            "format": "int32"
          },
          "moduleID": {
            "type": "integer",
            "format": "int32"
          },
          "module": {
            "$ref": "#/components/schemas/Module"
          },
          "dependsOnModuleID": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "Developer": {
        "type": "object",
        "properties": {
          "developerID": {
            "type": "integer",
            "format": "int32"
          },
          "developerName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "experience": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "DeveloperTechnology": {
        "type": "object",
        "properties": {
          "developerID": {
            "type": "integer",
            "format": "int32"
          },
          "techID": {
            "type": "integer",
            "format": "int32"
          },
          "proficiency": {
            "$ref": "#/components/schemas/ProficiencyLevel"
          },
          "yearsOfExperience": {
            "type": "integer",
            "format": "int32"
          },
          "lastUsed": {
            "type": "string",
            "format": "date-time"
          },
          "isCertified": {
            "type": "boolean"
          },
          "developer": {
            "$ref": "#/components/schemas/Developer"
          },
          "technology": {
            "$ref": "#/components/schemas/Technology"
          }
        },
        "additionalProperties": false
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Module": {
        "type": "object",
        "properties": {
          "moduleID": {
            "type": "integer",
            "format": "int32"
          },
          "moduleName": {
            "type": "string",
            "nullable": true
          },
          "version": {
            "type": "string",
            "nullable": true
          },
          "projectID": {
            "type": "integer",
            "format": "int32"
