# Dependency Risk Dashboard - root .gitignore
# Generated to ignore node, build artifacts, OS files, editor folders, and secrets

### Node dependencies
/node_modules/
**/node_modules/

### Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

### Runtime files
pids/
*.pid
*.seed
*.pid.lock

### Build outputs
/dist/
/build/
/.next/
/out/
/public/build/
/frontend/build/
frontend/dist/

### Test output
/coverage/
coverage/

### Environment variables (ignore all env files, keep example files)
.env
.env.*
!.env.example

### OS generated files
.DS_Store
Thumbs.db
desktop.ini

### IDEs and editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

### Misc caches
.cache/
.parcel-cache/
.turbo/
.next/cache
/.cache/

### Misc
*.tgz
*.gz
*.zip
*.sqlite
*.db
*.bak

### Optional: lockfiles are generally committed — do not ignore by default
# If you prefer to ignore lock files, uncomment the following lines
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

### Server editor swap and temporary files
*~
*.swp
*.swo

### Coverage and test reports
.nyc_output/
coverage/

### Docker
docker-compose.override.yml

### MacOS Finder metadata
.Spotlight-V100
.Trashes

# End of .gitignore
